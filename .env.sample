# -------------------------------
# Local paths and model registry
# -------------------------------
LOCAL_DATA_PATH=data/raw
LOCAL_REGISTRY_PATH=models
ARTIFACTS_DIR=models
MODEL_FILE=models/model_monotone.joblib
META_FILE=models/model_monotone.json

# -------------------------------
# Data and model sources
# -------------------------------
DATA_SOURCE=local
MODEL_TARGET=local

# -------------------------------
# Application and Docker settings
# -------------------------------
PORT=8000
DOCKER_LOCAL_PORT=8000
DOCKER_IMAGE_NAME=airbnb-paris-api
DEBUG=true

# -------------------------------
# Database configuration
# -------------------------------
DB_USER=airbnb
DB_PASSWORD=airbnb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airbnb
AIRBNB_DB_URL=postgresql://airbnb:airbnb@localhost:5432/airbnb

# -------------------------------
# Google Cloud configuration
# -------------------------------
GCP_PROJECT=your-gcp-project-id
GCP_REGION=europe-west1
DOCKER_REPO_NAME=airbnb-paris-repo
GAR_MEMORY=2Gi

# -------------------------------
# Streamlit server configuration
# -------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
